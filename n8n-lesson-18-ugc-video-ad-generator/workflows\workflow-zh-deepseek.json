        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"deepseek-chat\", \"messages\": [{\"role\": \"user\", \"content\": \"You are a UGC ad scriptwriter. From the product page below, write a short vertical video ad.\\nRespond with a JSON object containing exactly these fields:\\n- hook: a scroll-stopping first line (max 12 words)\\n- script: a 3-sentence voiceover-style script in a casual first-person UGC tone\\n- caption: an Instagram caption with up to 5 hashtags\\n- prompts: an array of exactly 3 different visual prompts (max 60 words each) for a 5 second 9:16 video, each a different angle (unboxing, in-use close-up, lifestyle). No on-screen text.\\n\\nTitle: ={{ $json.title }}\\nDescription: ={{ $json.description }}\\nPage text: ={{ $json.text }}\\n\\nRespond ONLY with the JSON object, no other text.\"}], \"response_format\": {\"type\": \"json_object\"}, \"max_tokens\": 1000, \"temperature\": 0.7}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
