      ],
      "parameters": {
        "jsCode": "const v = $input.all().map(i => i.json);\nconst s = $('Split Into Variants').first().json;\nconst lines = v.map(x => `Variant ${x.variant}: ${x.video_url || 'failed (' + x.status + ')'}`).join('\\n');\nreturn [{ json: { ready_count: v.filter(x => x.video_url).length, variants: v, caption: s.caption, message: `*New UGC ad for review*\\nHook: ${s.hook}\\nScript: ${s.script}\\n\\n${lines}\\n\\nCaption:\\n${s.caption}` } }];",
