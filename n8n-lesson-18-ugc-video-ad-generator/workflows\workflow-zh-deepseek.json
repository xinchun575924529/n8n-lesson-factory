        "jsCode": "return [{ json: { data: \"<html><head><meta property=\\\"og:title\\\" content=\\\"CoolGadget Pro - Smart Home Hub\\\"><meta property=\\\"og:description\\\" content=\\\"Control your entire home with one device. Voice control, app, automation.\\\"><meta property=\\\"og:image\\\" content=\\\"https://example.com/product.jpg\\\"><title>CoolGadget Pro</title></head><body><h1>CoolGadget Pro</h1><p>The ultimate smart home hub. Control lights, temperature, security cameras and more from one sleek device. Supports Alexa, Google Home, and HomeKit. Energy efficient with automatic scheduling.</p><span>$79.99</span><p>Over 10,000 happy customers. Easy 2-minute setup.</p></body></html>\" } }];",
