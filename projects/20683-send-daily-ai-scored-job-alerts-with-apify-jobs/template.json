      {
        "id": "a023823a-caed-4bef-be2f-1d41bc56e001",
        "name": "Fetch Jobs",
        "type": "n8n-nodes-base.httpRequest",
        "position": [
          1072,
          624
        ],
        "parameters": {
          "url": "https://api.apify.com/v2/acts/pk07007~ats-jobs-api/run-sync-get-dataset-items",
          "method": "POST",
          "options": {
            "timeout": 120000
          },
          "jsonBody": "={{ JSON.stringify({ keywords: $('Search Settings').first().json.keywords, countries: $('Search Settings').first().json.countries, city: $('Search Settings').first().json.city, workModes: $('Search Settings').first().json.workModes, maxItems: $('Search Settings').first().json.maxItems, postedAfter: $now.minus({ days: 1 }).toFormat('yyyy-MM-dd') }) }}",
          "sendBody": true,
          "sendQuery": true,
          "specifyBody": "json",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "queryParameters": {
            "parameters": [
              {
                "name": "maxTotalChargeUsd",
                "value": "={{ $('Search Settings').first().json.maxSpendUsd }}"
