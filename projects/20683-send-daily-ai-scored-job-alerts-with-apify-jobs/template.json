      {
        "id": "106f0ed9-8e02-4c0d-85f8-deb059b3487f",
        "name": "Get Seen IDs",
        "type": "n8n-nodes-base.googleSheets",
        "maxTries": 3,
        "position": [
          1312,
          624
        ],
        "parameters": {
          "options": {},
          "sheetName": {
            "__rl": true,
            "mode": "name",
            "value": "Jobs",
            "cachedResultName": "Jobs"
          },
          "documentId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $('Search Settings').first().json.sheetId }}",
            "cachedResultName": "Job tracker spreadsheet"
          }
        },
        "retryOnFail": true,
        "typeVersion": 4.5,
        "alwaysOutputData": true,
        "waitBetweenTries": 2000
      },
      {
        "id": "f2811b64-1af1-4ae3-9119-48399866f331",
        "name": "Filter & Prep",
        "type": "n8n-nodes-base.code",
        "position": [
          1552,
          624
        ],
        "parameters": {
          "jsCode": "const cfg = $('Search Settings').first().json;\nconst seen = new Set($('Get Seen IDs').all().map(i => String(i.json.id || '')).filter(Boolean));\nconst fetched = $('Fetch Jobs').all().map(i => i.json).filter(j => j && j.id);\nconst jobs = [];\nconst ids = new Set();\nfor (const j of fetched) {\n  const id = String(j.id);\n  if (seen.has(id) || ids.has(id)) continue;\n  ids.add(id);\n  jobs.push({ id, title: j.title, company: j.company, location: j.city || j.country || 'Remote', applyUrl: j.applyUrl });\n}\nconst list = jobs.map(j => j.id + ' | ' + j.title + ' | ' + j.company + ' | ' + j.location).join('\\n');\nconst prompt = 'You rate job fit. Candidate profile:\\n' + cfg.profile + '\\n\\nFor each job below (format: id | title | company | location) give an integer score 0-10 for how well it fits the candidate, and a reason of at most 12 words. Only title, company and location are known, so judge on those. Reply with ONLY a JSON array like [{\"id\":\"...\",\"score\":7,\"reason\":\"...\"}], one entry per job, no other text.\\n\\nJobs:\\n' + list;\nreturn [{ json: { jobs, count: jobs.length, prompt, model: cfg.claudeModel, keywords: cfg.keywords, topN: cfg.topN } }];"
        },
        "typeVersion": 2
      },
      {
        "id": "eb89b402-aeec-4e15-ad11-2878c8f6862c",
        "name": "Any New Jobs?",
        "type": "n8n-nodes-base.if",
        "position": [
          1792,
          624
        ],
        "parameters": {
          "options": {},
          "conditions": {
            "options": {
              "version": 1,
              "leftValue": "",
              "caseSensitive": true,
              "typeValidation": "strict"
            },
            "combinator": "and",
            "conditions": [
              {
                "id": "n1",
                "operator": {
                  "type": "number",
                  "operation": "gt"
                },
                "leftValue": "={{ $json.count }}",
                "rightValue": 0
              }
            ]
          }
        },
        "typeVersion": 2
      },
      {
        "id": "8a5723d3-6171-448b-8555-de315835b0ed",
        "name": "Score with Claude",
        "type": "n8n-nodes-base.httpRequest",
        "maxTries": 3,
        "position": [
          2080,
          528
        ],
        "parameters": {
          "url": "https://api.anthropic.com/v1/messages",
          "method": "POST",
          "options": {
            "timeout": 120000
          },
          "jsonBody": "={{ JSON.stringify({ model: $json.model, max_tokens: 4096, messages: [{ role: 'user', content: $json.prompt }] }) }}",
          "sendBody": true,
          "sendHeaders": true,
          "specifyBody": "json",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "headerParameters": {
            "parameters": [
              {
                "name": "anthropic-version",
                "value": "2023-06-01"
              }
            ]
          }
        },
        "retryOnFail": true,
        "typeVersion": 4.2,
        "waitBetweenTries": 2000
      },
      {
        "id": "9bbe2c52-04d0-4270-9a65-a44cfc565b32",
        "name": "Merge Scores",
        "type": "n8n-nodes-base.code",
        "position": [
          2272,
          528
        ],
        "parameters": {
          "jsCode": "const prep = $('Filter & Prep').first().json;\nconst scores = {};\ntry {\n  const txt = $json.content[0].text;\n  const arr = JSON.parse(txt.match(/[[sS]*]/)[0]);\n  for (const s of arr) scores[String(s.id)] = { score: Number(s.score), reason: String(s.reason || '') };\n} catch (e) {}\nconst now = new Date().toISOString();\n// Keep only jobs Claude actually scored. Unscored jobs are not logged, so they are retried on the next run.\nconst rows = prep.jobs\n  .filter(j => scores[j.id] && !isNaN(scores[j.id].score))\n  .map(j => ({ ...j, score: scores[j.id].score, reason: scores[j.id].reason }));\nif (!rows.length) throw new Error('Claude returned no readable scores. Check the Score with Claude node output; nothing was logged, so these jobs will be retried on the next run.');\nrows.sort((a, b) => b.score - a.score);\nconst topN = Number(prep.topN) || 5;\nreturn rows.map((r, i) => ({ json: { ...r, sent: i < topN, status: '', loggedAt: now, keywords: prep.keywords, total: rows.length } }));"
        },
        "typeVersion": 2
      },
      {
        "id": "bc0326aa-e4ef-44db-b877-83a63bf4bc26",
        "name": "Build Message",
        "type": "n8n-nodes-base.code",
        "position": [
          2464,
          528
        ],
        "parameters": {
          "jsCode": "const rows = $('Merge Scores').all().map(i => i.json).filter(r => r.sent);\nconst total = rows.length ? rows[0].total : 0;\nconst label = rows.length ? (rows[0].keywords || 'all jobs') : 'all jobs';\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst sc = r => (r.score === '' ? '?' : r.score) + '/10';\nconst header = 'Top ' + rows.length + ' of ' + total + ' new job(s) for \"' + label + '\":\\n\\n';\nconst lines = rows.map(r => '• [' + sc(r) + '] ' + r.title + ' @ ' + r.company + ' (' + r.location + ')\\n' + r.reason + '\\n' + r.applyUrl);\nlet out = header;\nlet shown = 0;\nfor (const l of lines) {\n  if ((out + l + '\\n\\n').length > 3900) break;\n  out += l + '\\n\\n';\n  shown++;\n}\nconst text = shown < lines.length ? out.trimEnd() + '\\n\\n+' + (lines.length - shown) + ' more' : out.trimEnd();\nconst html = '<h3>Top ' + rows.length + ' of ' + total + ' new job(s) for \"' + esc(label) + '\"</h3><ul>' +\n  rows.map(r => '<li><b>[' + sc(r) + ']</b> <a href=\"' + esc(r.applyUrl) + '\">' + esc(r.title) + '</a> @ ' + esc(r.company) + ' (' + esc(r.location) + ')<br>' + esc(r.reason) + '</li>').join('') + '</ul>';\nreturn [{ json: { text, html, subject: 'Job alert: ' + label, count: rows.length } }];"
        },
        "typeVersion": 2
      },
      {
        "id": "959e2a5d-4891-41ab-8657-b18f859ce5c8",
        "name": "Log to Sheet",
