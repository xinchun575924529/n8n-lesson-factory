    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $json.action || {};\nconst v = a.value || {};\nconst ctx = a.context || {};\nconst chat_id = ctx.chat_id || ctx.open_chat_id || '';\nconst fname = v.fname || '';\nconst ok = v.decision === 'approve';\nreturn [{ json: { __route: 'error', chat_id, reply_text: ok\n  ? `✅ 任务已确认（${fname}）。请打开 DJI Fly → 航点飞行，导入该任务后执行。`\n  : `❌ 任务已取消（${fname}）。` } }];"
      },
