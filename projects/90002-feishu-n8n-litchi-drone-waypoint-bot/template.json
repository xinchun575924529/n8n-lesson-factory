{
  "name": "飞书 + n8n + Litchi 航线机器人",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "feishu-drone-bot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "w1",
      "name": "Webhook 入口",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body ?? $json;\nif (b.challenge) return [{ json: { __type: 'challenge', challenge: b.challenge } }];\nconst t = b.header?.event_type || b.event?.header?.event_type || b.type || '';\nif (t === 'im.message.receive_v1') {\n  const msg = b.event.message;\n  let text = '';\n  try { text = JSON.parse(msg.content).text || ''; } catch (e) {}\n  return [{ json: { __type: 'message', text, chat_id: msg.chat_id || '' } }];\n}\nif (t === 'card.action.trigger' || b.action) {\n  return [{ json: { __type: 'card', action: b.action ?? b.event?.action ?? {} } }];\n}\nreturn [{ json: { __type: 'unknown' } }];"
      },
      "id": "c1",
      "name": "路由",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.__type }}",
              "rightValue": "challenge",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "if1",
      "name": "是Challenge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -160,
